# REQUIRED for direct Telegram post links and large-file playback.
# Create application credentials at https://my.telegram.org (server-side secrets).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Token from BotFather. Add this bot as an admin of your DB channel.
TELEGRAM_BOT_TOKEN=
# For https://t.me/c/2617067511/22047, the DB channel ID is -1002617067511.
# Add the SAME bot as admin to EVERY DB channel in this comma-separated list.
# Example with two: -1002617067511,-1001234567890
TELEGRAM_CHANNEL_IDS=-1002617067511
# Legacy single-channel fallback (ignored when the plural setting is non-empty).
TELEGRAM_CHANNEL_ID=-1002617067511, -1003573651004

# Hosting/resource settings. Keep MAX_STREAMS at 1 or 2 on a small instance.
PORT=8000
MAX_STREAMS=2
# REQUIRED: MongoDB catalog and resolved-post metadata (NOT the video files).
# Add your Koyeb service egress to MongoDB network access and use a scoped DB user.
MONGODB_URI=
MONGODB_DATABASE=watch_player

# OPTIONAL: only needed if using the older catalog/manifest/webhook workflow.
# Leave blank to disable these protected write endpoints.
ADMIN_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# REQUIRED playback access control (always enforced; missing secrets deny playback).
ALLOWED_SITE_ORIGIN=https://youngest-corabella-platinum0-23c07cdf.koyeb.app
# Generate TWO independent random values: openssl rand -hex 32
PLAYBACK_SIGNING_SECRET=
# Same issuer key must also be configured ONLY in the authorized site's backend.
PLAYBACK_ISSUER_KEY=
# Signed HttpOnly session lifetime: 120–900 seconds; refreshed while playing.
PLAYBACK_SESSION_TTL_SECONDS=600
